# ---------- Modelo ----------
# foundry (padrão) | azure-openai | openai
MODEL_PROVIDER=foundry

# Microsoft Foundry: Project ▸ Overview ▸ endpoint do projeto
FOUNDRY_PROJECT_ENDPOINT=https://SEU-RECURSO.services.ai.azure.com/api/projects/SEU-PROJETO
FOUNDRY_MODEL=gpt-4o-mini

# Alternativa: Azure OpenAI direto
# AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Alternativa: OpenAI ou endpoint compatível (Ollama, vLLM...)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1

# ---------- Banco ----------
DATABASE_URL=postgresql://maf:maf@localhost:5432/workshop

# ---------- Observabilidade ----------
# foundry | azure-monitor | aspire | console | none
#   foundry / azure-monitor → TODOS os exemplos (01–07) mandam traces, métricas e logs ao Application Insights
#   console                 → spans no terminal, só no 07 (para não poluir as outras demos)
OBS_TARGET=console

# Application Insights ▸ Overview ▸ Connection String
# Obrigatória para azure-monitor; opcional para foundry (se vazia, é lida do App Insights conectado ao projeto)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...;LiveEndpoint=https://...
